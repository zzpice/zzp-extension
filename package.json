{
  "name": "zzp-extension",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Zzp Home for Firefox",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write entrypoints scripts tests docs *.ts *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check entrypoints scripts tests docs *.ts *.json *.md .github/workflows/*.yml",
    "check": "pnpm typecheck && pnpm format:check && pnpm build && node scripts/audit.mjs",
    "lint:extension": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
