{
  "name": "zzp-extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Zzp Home for Firefox",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write entrypoints src scripts tests docs *.ts *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check entrypoints src scripts tests docs *.ts *.json *.md .github/workflows/*.yml",
    "check": "pnpm typecheck && pnpm format:check && pnpm test && pnpm build && node scripts/audit.mjs",
    "lint:extension": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "lucide-react": "1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
